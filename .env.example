# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file with real keys.

# Supabase (Phase 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Company time zone, for what counts as "today" on the jobs screen.
COMPANY_TIME_ZONE=America/New_York

# QuickBooks Online sandbox (Phase 4)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox
QBO_TOKEN_ENCRYPTION_KEY=
